# Public site URL (no trailing slash) — used for canonicals, sitemap, share links
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (service role — server only)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Resend (PDF email delivery)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=reports@yourdomain.com

# Optional — Lighthouse / CWV via PageSpeed Insights
GOOGLE_PAGESPEED_API_KEY=

# Optional — Chrome path for PDF generation
PUPPETEER_EXECUTABLE_PATH=

# Optional operator key (reserved for future dashboard)
DASHBOARD_API_KEY=
